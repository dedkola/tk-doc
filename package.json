{
  "name": "tk-doc",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "predev": "node scripts/generate-doc-git-dates.mjs",
    "dev": "next dev --turbopack",
    "prebuild": "node scripts/generate-doc-git-dates.mjs",
    "build": "next build",
    "build:worker": "CF_PAGES=1 pnpm run build",
    "start": "next start",
    "lint": "pnpm run check:code-fences && eslint app components config hooks lib scripts types eslint.config.mjs next.config.mjs postcss.config.mjs",
    "check:code-fences": "node scripts/check-code-fences.mjs",
    "format": "prettier --write app components config hooks lib scripts types .github .devcontainer README.md DOCKER-BUILD-PUSH.md compose.yaml package.json eslint.config.mjs next.config.mjs postcss.config.mjs tsconfig.json .prettierrc.json pnpm-workspace.yaml",
    "format:check": "prettier --check app components config hooks lib scripts types .github .devcontainer README.md DOCKER-BUILD-PUSH.md compose.yaml package.json eslint.config.mjs next.config.mjs postcss.config.mjs tsconfig.json .prettierrc.json pnpm-workspace.yaml"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.4.2",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.61.0",
    "next": "16.4.0",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "prism-react-renderer": "^2.4.1",
    "prismjs": "^1.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.4",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.2",
    "postcss": "^8.5.29",
    "prettier": "3.9.10",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "wrangler": "4.152.0"
  }
}
